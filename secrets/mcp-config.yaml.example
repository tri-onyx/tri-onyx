# TriOnyx MCP server — example configuration.
#
# Copy to secrets/mcp-config.yaml (gitignored) and edit. Secrets are pulled from
# the environment with ${VAR} interpolation; never inline them here.
#
#   cp secrets/mcp-config.yaml.example secrets/mcp-config.yaml
#   mkdir -p secrets/mcp-data
#
# Required in .env:
#   TRI_ONYX_CONNECTOR_TOKEN   shared gateway connector token (already used by
#                              the gateway and the chat connector)
#   MCP_OPERATOR_PASSWORD      the single credential that authorizes access
#                              (openssl rand -base64 32)
#   MCP_PUBLIC_URL             public https origin of the Cloudflare tunnel,
#                              e.g. https://mcp.example.com  (no trailing slash)
#   TUNNEL_TOKEN               Cloudflare Tunnel token (used by the sidecar)
#
# This file is maintained by hand — it is not produced by
# scripts/generate-templates.py, because that generator's redactor would strip
# these comments.

server:
  # Public origin, used verbatim as the OAuth issuer and to build every URL the
  # server hands out. Never derived from Host headers (we sit behind a tunnel).
  public_url: "${MCP_PUBLIC_URL}"

  # Bind inside the container. Do not publish this on 0.0.0.0 from compose —
  # cloudflared reaches it over the compose network.
  bind_host: 0.0.0.0
  bind_port: 8765

  # Streamable-HTTP endpoint path. claude.ai expects /mcp.
  mcp_path: /mcp

  name: trionyx
  title: TriOnyx

  # Optional: override the instructions sent to the MCP client. Left empty, the
  # server generates a description from the agent allowlist below.
  instructions: ""

  # Host/Origin validation for the /mcp endpoint. Leave enabled. If the tunnel
  # rewrites the Host header, add the value it sends to allowed_hosts rather
  # than disabling the check.
  dns_rebinding_protection: true
  allowed_hosts: []

gateway:
  url: "ws://gateway:4000/connectors/ws"
  token: "${TRI_ONYX_CONNECTOR_TOKEN}"
  connector_id: mcp

auth:
  # The ONLY credential that can authorize a connector. High entropy, rotated by
  # changing the env var and restarting (see docs/mcp-server.md).
  operator_password: "${MCP_OPERATOR_PASSWORD}"

  # Redirect URI allowlist. claude.ai only ever uses the first entry; anything
  # else is rejected at both /register and /authorize.
  redirect_uris:
    - "https://claude.ai/api/mcp/auth_callback"

  scope: "trionyx:chat"

  # Token lifetimes (seconds).
  auth_code_ttl_seconds: 300           # max 600
  access_token_ttl_seconds: 3600
  refresh_token_ttl_seconds: 2592000   # 30 days, absolute (refresh does not extend it)
  pending_authorization_ttl_seconds: 600

  # Brute-force protection on the operator login.
  max_login_failures: 5                # per client IP
  lockout_seconds: 900                 # 15 minutes
  global_failure_threshold: 20         # beyond this, every attempt is delayed
  global_backoff_max_seconds: 30

  # Registration is open (the MCP spec requires it) but grants nothing without
  # an operator login; these bound the stored registrations. Tokenless
  # registrations beyond the cap evict the oldest; stale ones are pruned.
  max_registered_clients: 10
  client_ttl_seconds: 2592000          # 30 days

  # Where the hashed OAuth state lives. Mounted from ./secrets/mcp-data so
  # authorization survives a container restart. Losing it just means re-auth.
  data_dir: /data

session:
  # Every message forwarded to the gateway carries this identity. The operator
  # is the only principal that can be behind a valid token.
  sender: mcp-operator
  trust_level: verified

  # Channel room ids are "<room_prefix>-<conversation_id>", keeping MCP sessions
  # in their own namespace.
  room_prefix: mcp

  # Max wait for one agent turn before the tool returns a clean error.
  timeout_seconds: 300

# The allowlist. Only these agents are reachable, and the descriptions here are
# what `list_agents` returns — the gateway is never asked to enumerate agents.
agents:
  - name: main
    description: >-
      Primary router. Knows the overall system and can delegate to the other
      agents. Start here if you are not sure who to ask.
  - name: researcher
    description: >-
      Deep research over the web and the knowledge base. Slow but thorough.
